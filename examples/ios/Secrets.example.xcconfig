// DEMO ONLY. Copy to Secrets.xcconfig (git-ignored) and fill in.
// A real app never ships the API secret: its backend calls /api/v1/auth/login and hands the app a token.
TRACKME_API_SECRET = your_api_secret_here

// Baato map style key for the live map: https://api.baato.io/api/v1/styles/breeze?key=…
BAATO_ACCESS_TOKEN = your_baato_access_token_here

// YES = show the Developer screens next to the Live map, NO = Live map only. Leave empty: Debug on, Release off.
TRACKME_DEV_TOOLS =

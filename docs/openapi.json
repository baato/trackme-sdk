  "components": {
    "schemas": {
      "CursorPage_NotificationResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NotificationResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "items",
          "has_more"
        ],
        "title": "CursorPage[NotificationResponse]"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocationIngestResponse": {
        "properties": {
          "accepted": {
            "type": "boolean",
            "title": "Accepted",
            "default": true
          },
          "trip_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Trip Ids"
          },
          "fix_age_s": {
            "type": "integer",
            "title": "Fix Age S",
            "default": 0
          }
        },
        "type": "object",
        "title": "LocationIngestResponse"
      },
      "LocationPayload": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon"
          },
          "timestamp": {
            "type": "integer",
            "title": "Timestamp"
          },
          "accuracy": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy"
          },
          "altitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 400.0,
                "minimum": 0.0
